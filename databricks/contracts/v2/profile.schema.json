{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:magneto:contracts:v2:profile",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {"const": "2.0"},
    "profile_id": {"type": "string", "format": "uuid", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"},
    "consent": {"enum": ["granted", "revoked"]},
    "preferences": {"type": "object", "additionalProperties": false, "properties": {"audio_enabled": {"type": "boolean"}}, "required": ["audio_enabled"]}
  },
  "required": ["schema_version", "profile_id", "consent", "preferences"]
}
