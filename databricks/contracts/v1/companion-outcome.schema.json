{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:magneto:contracts:v1:companion-outcome",
  "title": "Magneto companion outcome",
  "description": "One learner response and its execution evidence, recorded by the Orin harness after a bounded tool action. It reports what was spoken, shown and heard; it asserts no mastery and never repeats a physical action on retry.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": { "const": "1.0" },
    "outcome_id": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "session_id": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "revision": { "type": "integer", "minimum": 0 },
    "target": { "type": "string", "minLength": 1, "maxLength": 32 },
    "activity": { "enum": ["introduce", "identify", "match", "spell"] },
    "expected": { "type": "string", "maxLength": 32 },
    "transcript": { "type": "string", "maxLength": 300 },
    "match": { "enum": ["exact", "partial", "none"] },
    "outcome": { "enum": ["correct", "incorrect", "help", "unrecognized"] },
    "source": { "enum": ["stt", "typed", "teacher"] },
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "spoken": { "type": "boolean" },
        "shown": { "type": "boolean" },
        "cell_ack": { "type": "boolean" },
        "cell_connected": { "type": "boolean" }
      },
      "required": ["spoken", "shown", "cell_ack", "cell_connected"]
    },
    "received_at_ms": { "type": "integer", "minimum": 0 }
  },
  "required": [
    "schema_version",
    "outcome_id",
    "session_id",
    "revision",
    "target",
    "activity",
    "expected",
    "transcript",
    "match",
    "outcome",
    "source",
    "execution",
    "received_at_ms"
  ]
}
