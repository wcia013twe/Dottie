{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Synthetic Story persona v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "synthetic",
    "source",
    "display_name",
    "experience_level",
    "purpose",
    "about_me",
    "possible_patterns",
    "teaching_preferences",
    "typical_phrases",
    "goals",
    "testing_note"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1000
    },
    "synthetic": {
      "const": true
    },
    "source": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1000
    },
    "display_name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1000
    },
    "experience_level": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1000
    },
    "purpose": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1000
    },
    "about_me": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1000
    },
    "possible_patterns": {
      "type": "array",
      "minItems": 1,
      "maxItems": 12,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 500
      }
    },
    "teaching_preferences": {
      "type": "array",
      "minItems": 1,
      "maxItems": 12,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 500
      }
    },
    "typical_phrases": {
      "type": "array",
      "minItems": 1,
      "maxItems": 12,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 500
      }
    },
    "goals": {
      "type": "array",
      "minItems": 1,
      "maxItems": 12,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 500
      }
    },
    "testing_note": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1000
    }
  }
}
