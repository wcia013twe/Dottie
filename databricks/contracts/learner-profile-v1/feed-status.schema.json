{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "state",
    "connected",
    "source",
    "event_count",
    "checked_at",
    "error",
    "genie"
  ],
  "properties": {
    "state": {
      "enum": [
        "checking",
        "syncing",
        "connected",
        "unavailable"
      ]
    },
    "connected": {
      "type": "boolean"
    },
    "source": {
      "const": "workspace.magneto.learner_observations_v1"
    },
    "event_count": {
      "type": "integer",
      "minimum": 0
    },
    "checked_at": {
      "type": [
        "number",
        "null"
      ]
    },
    "error": {
      "type": [
        "string",
        "null"
      ]
    },
    "genie": {
      "enum": [
        "unavailable_403",
        "available_not_integrated",
        "checking",
        "analyzing",
        "connected",
        "unavailable"
      ]
    }
  }
}
