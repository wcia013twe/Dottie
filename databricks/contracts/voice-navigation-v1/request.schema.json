{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "text": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500,
      "pattern": "\\S"
    },
    "route": {
      "enum": [
        "home",
        "explore",
        "practice",
        "stories",
        "intelligence",
        "guess",
        "match",
        "letters",
        "connect"
      ]
    },
    "story_reader": {
      "type": "boolean"
    }
  },
  "required": [
    "text",
    "route",
    "story_reader"
  ]
}
